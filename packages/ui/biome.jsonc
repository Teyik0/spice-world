{
  "root": false,
  "extends": ["../../biome.jsonc", "ultracite/biome/react"],
  "linter": {
    "rules": {
      // TanStack Form's documented pattern passes inline field handlers (as apps/web).
      "performance": { "noJsxPropsBind": "off" },
    },
  },
  "overrides": [
    {
      // Generated by the shadcn CLI: not linted, so `shadcn add --diff` stays meaningful.
      // Hand-written components (form.tsx, *-form.tsx) stay linted.
      "includes": [
        "src/components/**",
        "src/hooks/**",
        "!src/components/form.tsx",
        "!src/components/*-form.tsx",
      ],
      "linter": { "enabled": false },
    },
  ],
}
