+// Temporary nested-file serialization until Eden supports it upstream.
+// Multipart arrays that are empty or hold anything but files are sent as one JSON field, so single-item and empty primitive arrays stay arrays (eden#276).
+function edenNestedFileBody(body, isFile, hasFile) {
+  const fields = [], files = [];
+  function extract(value, path) {
+    if (isFile(value)) {
+      files.push([path, value]);
+      return undefined;
+    }
+    if (!value || typeof value !== "object" || !hasFile(value)) return value;
+    if (Array.isArray(value)) return value.map((child, index) => extract(child, `${path}[${index}]`));
