{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "allowImportingTsExtensions": true,
    "paths": {
      "@spice-world/server/*": ["../server/src/*"]
    }
  },
  "include": ["src", "furin.config.ts"]
}
