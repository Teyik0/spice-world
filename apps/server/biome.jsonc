{
  "root": false,
  "extends": ["../../biome.jsonc"],
  "linter": {
    "rules": {
      "performance": {
        "noNamespaceImport": "off",
      },
    },
  },
  "overrides": [
    {
      "includes": ["src/modules/**/errors.ts"],
      "linter": {
        "rules": {
          "style": { "noExcessiveClassesPerFile": "off" },
        },
      },
    },
  ],
}
