{
  "name": "@spice-world/server",
  "version": "0.1.0",
  "private": true,
  "module": "src/index.ts",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "PORT=3001 bun run --bun --watch --cpu-prof --cpu-prof-name '@spice-world/server' --inspect --title '@spice-world/server' src/index.ts",
    "stripe": "stripe listen --events checkout.session.completed,checkout.session.async_payment_failed,checkout.session.expired --forward-to localhost:3001/api/auth/stripe/webhook",
    "test": "bun test --randomize --parallel=4 --concurrent --bail --timeout=20000",
    "build": "bun build src/index.ts --compile --target=bun --format=esm --bytecode --minify-whitespace --minify-syntax --sourcemap --define 'process.env.NODE_ENV=process.env.NODE_ENV' --outfile=dist/server",
    "start": "NODE_ENV=production PORT=3001 ./dist/server",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.28",
    "@better-auth/stripe": "^1.7.28",
    "@elysia/cors": "rc",
    "@elysia/openapi": "rc",
    "@elysia/opentelemetry": "rc",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
    "@opentelemetry/sdk-trace-node": "^2.12.1",
    "@spice-world/emails": "workspace:*",
    "better-auth": "^1.7.28",
    "drizzle-orm": "^1.0.0-rc.5-ab785fc",
    "elysia": "catalog:",
    "evlog": "2.37.1",
    "file-type": "^22.3.0",
    "react": "catalog:",
    "resend": "^6.40.0",
    "stripe": "^23.2.0",
    "typebox": "catalog:",
    "uploadthing": "^7.7.4"
  },
  "devDependencies": {
    "@elysia/eden": "catalog:",
    "@types/react": "catalog:",
    "drizzle-kit": "^1.0.0-rc.5",
    "drizzle-seed": "^1.0.0-rc.5"
  }
}
