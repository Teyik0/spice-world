{
  "root": true,
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  "formatter": {
    "enabled": false,
  },
  "json": {
    "formatter": {
      "enabled": false,
    },
  },
  "javascript": {
    "globals": ["Bun"],
  },
  "css": {
    "formatter": {
      "enabled": false,
    },
    "parser": {
      "tailwindDirectives": true,
    },
  },
  "linter": {
    "rules": {
      "nursery": {},
      "style": {
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "interface",
          },
        },
      },
      "a11y": {
        "useSemanticElements": "off",
      },
    },
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off",
        "useSortedPackageJson": "off",
        "useSortedKeys": "off",
      },
    },
  },
}
